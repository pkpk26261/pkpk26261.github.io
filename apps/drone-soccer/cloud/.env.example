# Deployment example only. These values are configured as service secrets;
# never commit a completed .env file or the actual ADMIN_TOKEN.
NODE_ENV=production
PORT=10000
DATA_DIR=/data
MAX_ARENAS=2

# Required: supply a unique random secret of at least 32 characters.
ADMIN_TOKEN=

# Render sets RENDER_EXTERNAL_URL automatically, so PUBLIC_ORIGIN can be
# omitted there. For another provider, set the final public HTTPS origin.
# PUBLIC_ORIGIN=https://your-game.example.com
